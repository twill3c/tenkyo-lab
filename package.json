{
  "name": "tenkyo-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "fetch": "node scripts/fetch-laws.mjs",
    "chunks": "node scripts/build-chunks.mjs",
    "oracle": "node scripts/build-oracle.mjs",
    "review": "node scripts/sample-review.mjs",
    "embed": "node scripts/embed.mjs",
    "embed:queries": "node scripts/embed-queries.mjs",
    "embed:negatives": "node scripts/embed-queries.mjs --source data/negatives.json --name negative",
    "eval": "node scripts/evaluate.mjs",
    "test:py": "python -m pytest harness/reference -q",
    "dump:ts": "node scripts/dump-ranks.mjs",
    "dump:py": "python harness/reference/dump_ranks.py",
    "compare": "node scripts/compare-impl.mjs",
    "quantize": "node scripts/quantize.mjs",
    "sweep": "node scripts/hybrid-sweep.mjs",
    "control:dense": "node scripts/dense-control.mjs",
    "fetch:model": "node scripts/fetch-model.mjs",
    "keep-extra": "node scripts/keep-extra.mjs",
    "prune": "python scripts/prune_model.py --ascii-max 2",
    "verify:prune": "node scripts/verify-prune.mjs",
    "pack": "node scripts/pack-index.mjs",
    "vendor": "node scripts/vendor-runtime.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve-out.mjs",
    "inspect": "node scripts/inspect-browser.mjs",
    "pack:eval": "node scripts/pack-eval.mjs",
    "prefix": "node scripts/prefix-experiment.mjs",
    "granularity": "node scripts/granularity-compare.mjs",
    "chunks:article": "node scripts/build-chunks.mjs --granularity article --out data/chunks-article.json"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "next": "^15.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
